<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_mrp_bom_cnc_form" model="ir.ui.view">
        <field name="name">mrp.bom.cnc.form</field>
        <field name="model">mrp.bom.cnc</field>
        <field name="arch" type="xml">
            <form string="BOM CNC Configuration">
                <sheet>
                    <group>
                        <field name="sequence"/>
                        <field name="cnc_number"/>
                        <field name="quantity"/>
                        <field name="render_3d_file" filename="render_3d_filename" widget="binary"/>
                        <field name="render_3d_filename" invisible="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_mrp_bom_form_cnc_configuration" model="ir.ui.view">
        <field name="name">mrp.bom.form.cnc.configuration</field>
        <field name="model">mrp.bom</field>
        <field name="inherit_id" ref="mrp.mrp_bom_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="CNC" name="cnc_configuration_page">
                    <field name="cnc_config_ids" context="{'default_bom_id': id}">
                        <list editable="bottom" create="1" delete="1">
                            <field name="sequence" widget="handle"/>
                            <field name="cnc_number"/>
                            <field name="quantity"/>
                        </list>
                        <form string="BOM CNC Configuration">
                            <group>
                                <field name="sequence"/>
                                <field name="cnc_number"/>
                                <field name="quantity"/>
                                <field name="render_3d_file" filename="render_3d_filename" widget="binary"/>
                                <field name="render_3d_filename" invisible="1"/>
                            </group>
                        </form>
                    </field>
                </page>
            </xpath>
        </field>
    </record>
</odoo>