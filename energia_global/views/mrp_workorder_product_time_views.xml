<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_mrp_workorder_product_time_tree" model="ir.ui.view">
        <field name="name">mrp.workorder.product.time.tree</field>
        <field name="model">mrp.workorder.product.time</field>
        <field name="arch" type="xml">
            <list>
                <field name="workorder_id"/>
                <field name="move_id"/>
                <field name="product_id"/>
                <field name="user_id"/>
                <field name="date_start"/>
                <field name="date_end"/>
                <field name="duration"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <record id="view_mrp_workorder_product_time_form" model="ir.ui.view">
        <field name="name">mrp.workorder.product.time.form</field>
        <field name="model">mrp.workorder.product.time</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="workorder_id"/>
                        <field name="move_id"/>
                        <field name="product_id"/>
                        <field name="user_id"/>
                        <field name="state"/>
                    </group>
                    <group>
                        <field name="date_start"/>
                        <field name="date_end"/>
                        <field name="duration"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
</odoo>
