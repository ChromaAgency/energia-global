<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_product_template_form_energia_global" model="ir.ui.view">
        <field name="name">product.template.form.energia.global</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='general_information']//group[@name='group_general']" position="inside">
                <field name="sheet_type"/>
                <field name="broad"/>
                <field name="long"/>
                <field name="superficie"/>
                <field name="thickness_measurements"/>
                <field name="gross_weight"/>
                <field name="client_tag_ids" widget="many2many_tags"/>
            </xpath>
            <xpath expr="//notebook" position="inside">
                <page string="Planos" name="product_planos_page">
                    <group>
                        <field name="render_3d_file" filename="render_3d_filename" widget="binary"/>
                        <field name="render_3d_filename" invisible="1"/>
                    </group>
                    <field name="plano_ids" context="{'default_product_tmpl_id': id}">
                        <list editable="bottom">
                            <field name="sequence" widget="handle"/>
                            <field name="name"/>
                            <field name="cnc_number"/>
                            <field name="render_3d_file" filename="render_3d_filename" widget="binary"/>
                            <field name="render_3d_filename" column_invisible="1"/>
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>

    <record id="view_thickness_measurements_tree" model="ir.ui.view">
        <field name="name">thickness.measurements.list</field>
        <field name="model">thickness.measurements</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="name"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="action_thickness_measurements" model="ir.actions.act_window">
        <field name="name">Espesores</field>
        <field name="res_model">thickness.measurements</field>
        <field name="view_mode">list</field>
    </record>

    <menuitem id="menu_thickness_measurements"
              name="Espesores"
              parent="stock.menu_stock_config_settings"
              action="action_thickness_measurements"
              sequence="80"/>

    <record id="view_product_client_tag_tree" model="ir.ui.view">
        <field name="name">product.client.tag.list</field>
        <field name="model">product.client.tag</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="name"/>
                <field name="color" widget="color_picker"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="action_product_client_tag" model="ir.actions.act_window">
        <field name="name">Etiquetas de Cliente</field>
        <field name="res_model">product.client.tag</field>
        <field name="view_mode">list</field>
    </record>

    <menuitem id="menu_product_client_tag"
              name="Etiquetas de Cliente"
              parent="product.menu_product_config"
              action="action_product_client_tag"
              sequence="90"/>

</odoo>
