<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-inherit="mrp_workorder.MrpDisplayRecord" t-inherit-mode="extension">
        <xpath expr="//div[contains(@class, 'o_mrp_display_record_title')]/h4" position="replace">
            <div class="d-flex flex-column">
                <h4 class="mb-0 text-wrap text-break font-monospace" t-out="props.record.resModel === 'mrp.workorder' ? props.production.data.origin ? props.production.data.origin : props.production.data.display_name : props.record.data.origin ? props.record.data.origin : props.record.data.display_name"/>
                <h6 class="mb-0" t-if="props.record.resModel === 'mrp.workorder' ? props.production.data.customer_name : props.record.data.customer_name" t-out="(props.record.resModel === 'mrp.workorder' ? props.production.data.customer_name : props.record.data.customer_name)"/>
            </div>
        </xpath>
        <xpath expr="//div[contains(@class, 'o_mrp_display_record_title')]" position="after">
            <t t-if="showCncPanel">
                <div class="w-100 mt-2 border rounded p-2">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <strong>CNC</strong>
                        <span class="small text-muted" t-if="cncUiState.loading">Cargando...</span>
                    </div>
                    <div t-if="!cncUiState.loading and !cncUiState.records.length">
                        <span class="small text-muted">Sin registros CNC para esta OF.</span>
                    </div>
                    <div class="d-flex flex-column gap-2" t-if="cncUiState.records.length">
                        <t t-foreach="cncUiState.records" t-as="cnc" t-key="cnc.id">
                            <div class="border rounded p-2">
                                <div class="d-flex justify-content-between align-items-start gap-2 flex-wrap">
                                    <div class="d-flex flex-column">
                                        <span class="fw-bold" t-out="cnc.cnc_number"/>
                                        <span class="small text-muted">
                                            Cantidad: <t t-out="cnc.quantity"/> | Estado: <t t-out="cnc.state"/> | Tiempo: <t t-out="_formatCncDuration(cnc.duration)"/>
                                        </span>
                                    </div>
                                    <div class="btn-group">
                                        <button type="button" class="btn btn-outline-secondary btn-sm" t-if="_canOpenCncPlan(cnc)" t-on-click="(ev) => this.onOpenCncPlan(cnc, ev)">
                                            Plano
                                        </button>
                                        <button type="button" class="btn btn-primary btn-sm" t-if="_canStartCnc(cnc)" t-on-click="(ev) => this.onStartCnc(cnc, ev)">
                                            Iniciar
                                        </button>
                                        <button type="button" class="btn btn-secondary btn-sm" t-if="_canPauseCnc(cnc)" t-on-click="(ev) => this.onPauseCnc(cnc, ev)">
                                            Pausar
                                        </button>
                                        <button type="button" class="btn btn-secondary btn-sm" t-if="_canResumeCnc(cnc)" t-on-click="(ev) => this.onResumeCnc(cnc, ev)">
                                            Continuar
                                        </button>
                                        <button type="button" class="btn btn-success btn-sm" t-if="_canFinishCnc(cnc)" t-on-click="(ev) => this.onFinishCnc(cnc, ev)">
                                            Terminar
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </t>
                    </div>
                </div>
            </t>
        </xpath>
        <xpath expr="//t[@t-foreach='moves']" position="attributes">
            <attribute name="t-key">move.resId</attribute>
        </xpath>
        <xpath expr="//t[@t-foreach='checks']" position="attributes">
            <attribute name="t-key">check.resId</attribute>
        </xpath>
        <xpath expr="//t[@t-foreach='byProducts']" position="attributes">
            <attribute name="t-key">byproductMove.resId</attribute>
        </xpath>
    </t>
    
    <t t-inherit="mrp_workorder.StockMove" t-inherit-mode="extension">
        <xpath expr="(//span[contains(@class, 'o_line_label')])[1]" position="after">
            <div class="d-flex flex-column flex-grow-1">
                <t t-if="props.record.data.final_product_id">
                    <div class="text-muted small">
                        Producto intermedio:
                        <t t-out="props.record.data.final_product_id.display_name"/>
                    </div>
                </t>
                <t t-if="props.record.data.component_operation_stage_label">
                    <div class="text-muted small mt-1">
                        Etapa: <t t-out="props.record.data.component_operation_stage_label"/>
                    </div>
                </t>
                <t t-if="props.record.data.component_finalization_state_label">
                    <div class="text-muted small mt-1">
                        Estado componente: <t t-out="props.record.data.component_finalization_state_label"/>
                    </div>
                </t>
                <t t-if="props.record.data.related_workcenter_ids &amp;&amp; props.record.data.related_workcenter_ids.records &amp;&amp; props.record.data.related_workcenter_ids.records.length">
                    <div class="text-muted small">
                        <t t-foreach="props.record.data.related_workcenter_ids.records" t-as="wc" t-key="wc.resId">
                            <t t-out="wc.display_name"/>
                        </t>
                    </div>
                </t>
                <t t-if="props.record.data.has_render_3d || props.record.data.render_3d_filename">
                    <div class="mt-1">
                        <button type="button" class="btn btn-outline-secondary btn-sm" t-on-click="openThreeDViewer">
                            Plano
                        </button>
                    </div>
                </t>
                <t t-if="showBlockedInfo">
                    <div class="text-danger small" t-out="uiState.blockedByText"/>
                </t>
                <div class="btn-group mt-1">
                    <button type="button" class="btn btn-primary btn-sm" t-if="showStartButton" t-on-click="onStartPiece">
                        Iniciar
                    </button>
                    <button type="button" class="btn btn-secondary btn-sm" t-if="showPauseStopButtons" t-on-click="onPausePiece">
                        Pausar
                    </button>
                    <button type="button" class="btn btn-danger btn-sm" t-if="showPauseStopButtons" t-on-click="onStopPiece">
                        Detener
                    </button>
                </div>
            </div>
        </xpath>
    </t>
</templates>
